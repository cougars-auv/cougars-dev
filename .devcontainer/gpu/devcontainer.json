{
  "name": "CoUGARs Dev (HoloOcean)",
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "docker-compose.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/home/frostlab-docker/cougars-dev",
  "remoteUser": "frostlab-docker",
  "updateRemoteUserUID": true,
  "hostRequirements": {
    "gpu": true
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:": {},
    "ghcr.io/devcontainers/features/nvidia-cuda:3.0.0": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [
          100
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[cpp]": {
          "editor.defaultFormatter": "ms-vscode.cpptools"
        },
        "[c]": {
          "editor.defaultFormatter": "ms-vscode.cpptools"
        }
      },
      "extensions": [
        "Anthropic.claude-code",
        "charliermarsh.ruff",
        "docker.docker",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "mechatroner.rainbow-csv",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-vscode.cpptools",
        "nonanonno.vscode-ros2",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "twxs.cmake"
      ]
    }
  },
  "postCreateCommand": [
    "/bin/bash",
    ".devcontainer/post-create-command.sh"
  ],
  "postStartCommand": [
    "/bin/bash",
    ".devcontainer/post-start-command.sh"
  ]
}
