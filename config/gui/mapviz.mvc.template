capture_directory: "~"
fixed_frame: map
target_frame: map
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1600
window_height: 900
view_scale: 0.75
offset_x: -11
offset_y: -22.5
use_latest_transforms: true
background: "#a0a0a4"
image_transport: raw
displays:
  - type: mapviz_plugins/tile_map
    name: new display
    config:
      visible: true
      collapsed: true
      custom_sources:
        - base_url: http://localhost:8080/wmts/gm_layer/gm_grid/{level}/{x}/{y}.png
          max_zoom: 19
          name: mapproxy-ct
          type: wmts
      bing_api_key: ""
      stadia_api_key: ""
      source: mapproxy-ct
  - type: coug_mapviz/coug_waypoints
    name: new display
    config:
      visible: true
      collapsed: false
  - type: mapviz_plugins/pointcloud2
    name: Ground
    config:
      visible: false
      collapsed: true
      topic: /<agent_ns>/ground_segmentation/ground_points
      size: 1
      buffer_size: 1
      alpha: 1
      color_transformer: Flat Color
      min_color: "#00ff00"
      max_color: "#000000"
      value_min: 0
      value_max: 100
      use_rainbow: false
      use_automaxmin: false
      unpack_rgb: false
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/pointcloud2
    name: Obstacles
    config:
      visible: false
      collapsed: true
      topic: /<agent_ns>/ground_segmentation/obstacle_points
      size: 1
      buffer_size: 1
      alpha: 1
      color_transformer: Flat Color
      min_color: "#ff00ff"
      max_color: "#000000"
      value_min: 0
      value_max: 100
      use_rainbow: false
      use_automaxmin: false
      unpack_rgb: false
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/occupancy_grid
    name: Global Costmap
    config:
      visible: false
      collapsed: true
      alpha: 1
      topic: /<agent_ns>/global_costmap/costmap
      update: false
      scheme: costmap
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/occupancy_grid
    name: Local Costmap
    config:
      visible: false
      collapsed: true
      alpha: 1
      topic: /<agent_ns>/local_costmap/costmap
      update: false
      scheme: costmap
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/path
    name: Navfn
    config:
      visible: false
      collapsed: true
      topic: /<agent_ns>/plan
      color: "#00ff00"
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/marker
    name: MPPI
    config:
      visible: false
      collapsed: true
      topic: /<agent_ns>/trajectories
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/tf_frame
    name: Robot
    config:
      visible: true
      collapsed: true
      frame: <agent_ns>/base_link
      color: "#00ff00"
      draw_style: arrows
      position_tolerance: 0
      buffer_size: 1
      static_arrow_sizes: true
      arrow_size: 53
  - type: mapviz_plugins/navsat
    name: GPS Fix
    config:
      visible: true
      collapsed: true
      topic: /<agent_ns>/gps/fix
      color: "#55aaff"
      draw_style: points
      position_tolerance: 0
      buffer_size: 1
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/path
    name: Smoothed Path
    config:
      visible: true
      collapsed: true
      topic: /<agent_ns>/smoothed_path
      color: "#ff55ff"
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/odometry
    name: GT
    config:
      visible: true
      collapsed: true
      topic: /<agent_ns>/odometry/truth
      color: "#ffffff"
      draw_style: lines
      position_tolerance: 0
      buffer_size: 0
      show_laps: false
      show_covariance: false
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
