<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coug_bringup</name>
  <version>0.0.0</version>
  <description>Full-system launch files for the CougUV</description>
  <maintainer email="snelsondurrant@gmail.com">snelsondurrant</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>coug_interfaces</exec_depend>
  <exec_depend>coug_description</exec_depend>
  <exec_depend>coug_fgo</exec_depend>
  <exec_depend condition="$ROS_BUILD_ARCH == 'amd64'">coug_mapviz</exec_depend>
  <exec_depend>coug_helm</exec_depend>
  <exec_depend>coug_rqt</exec_depend>
  <exec_depend>coug_active_fgo</exec_depend>
  <exec_depend>coug_visual_dvl</exec_depend>
  <exec_depend>holoocean_bridge</exec_depend>
  <exec_depend>gpsd_client</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>ntrip_client</exec_depend>
  <exec_depend>sbg_driver</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
